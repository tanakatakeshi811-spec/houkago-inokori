{
  "name": "houkago-inokori-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "QUEUE", "class_name": "MatchQueue" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "MatchQueue"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "houkago-inokori-db",
      "database_id": "318b407d-301b-4e0d-9eaa-baf848c15025"
    }
  ]
}
